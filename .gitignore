# Segredos
.env

# Dados baixados e gerados (o manifesto em etl.etl_arquivo permite rebaixar)
data/raw/*
data/interim/*
data/processed/*
!data/raw/.gitkeep
!data/interim/.gitkeep
!data/processed/.gitkeep
*.zip
*.ZIP
!tests/fixtures/**/*.zip

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/
build/
dist/

# Sistema / editores
.DS_Store
Thumbs.db
.vscode/
.idea/
~$*

# Copie este arquivo para ".env" e troque as senhas.
# O arquivo .env NÃO vai para o Git (está no .gitignore).

# --- Banco de dados (usuário de ETL: dono dos esquemas) ---
OBS_DB_HOST=localhost
OBS_DB_PORTA=5432
OBS_DB_NOME=observatorio
OBS_DB_USUARIO=observatorio_etl
OBS_DB_SENHA=troque-esta-senha

# --- Usuário somente leitura usado pelo Power BI ---
# O nome do papel é fixo: powerbi_leitor (enxerga apenas o esquema bi). Defina só a senha.
OBS_POWERBI_SENHA=troque-esta-senha-tambem

# --- Coleta ---
# Pasta onde ficam os arquivos baixados (padrão: ./data)
OBS_DIR_DADOS=data
# Manter o ZIP bruto do Censo Escolar depois de processado? (true/false)
# O manifesto (URL + sha256) permite baixar e conferir de novo se apagar.
OBS_MANTER_ZIP_BRUTO=true
# Pausa (segundos) entre chamadas às APIs
OBS_PAUSA_ENTRE_CHAMADAS=1.0
# Tempo máximo (segundos) de cada requisição HTTP
OBS_TIMEOUT_HTTP=120
# Nível de log: DEBUG, INFO, WARNING
OBS_NIVEL_LOG=INFO
